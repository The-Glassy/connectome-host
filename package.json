{
  "name": "@animalabs/connectome-host",
  "version": "0.19.0",
  "description": "Recipe-configured host for long-lived agents on the Connectome stack: TUI, headless daemon, fleets, and a web operator console",
  "type": "module",
  "files": [
    "src",
    "recipes",
    "scripts",
    "docs",
    "dist/web",
    "tsconfig.json",
    ".env.example",
    "ARCHITECTURE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "preversion": "node scripts/release-bump.mjs && node scripts/release-holds.mjs",
    "version": "bun scripts/release-changelog.ts && git add CHANGELOG.md changelog.d",
    "prepack": "node scripts/pack-contents.mjs",
    "prepublishOnly": "node scripts/release-holds.mjs",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build:web:ci": "npm ci --prefix web && npm --prefix web run build",
    "relock:web": "rm -rf web/node_modules web/package-lock.json && npm --prefix web install"
  },
  "dependencies": {
    "@animalabs/agent-framework": "file:./vendor/animalabs-agent-framework-0.30.0-361-172ed7d8.tgz",
    "@animalabs/chronicle": "^0.5.1",
    "@animalabs/context-manager": "file:./vendor/animalabs-context-manager-0.24.2-416-01f3a85.tgz",
    "@animalabs/membrane": "^0.8.0",
    "@opentui/core": "^0.1.82"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anima-research/connectome-host.git"
  },
  "homepage": "https://github.com/anima-research/connectome-host#readme",
  "bugs": {
    "url": "https://github.com/anima-research/connectome-host/issues"
  },
  "connectomeRelease": {
    "breaking": true
  },
  "overrides": {
    "@animalabs/context-manager": "file:./vendor/animalabs-context-manager-0.24.2-416-01f3a85.tgz"
  }
}
